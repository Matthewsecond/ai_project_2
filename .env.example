# ── Country selection ────────────────────────────────────────────────────────
# Chosen at launch with a CLI flag (default Austria):
#   python app.py                # Austria
#   python app.py --country sk   # Slovakia   (shortcut: --sk)
# The vars below are credentials for each market; --country picks which apply.

OPENAI_API_KEY=sk-proj-...

# ── Austria (COUNTRY=at) ───────────────────────────────────────────────────────
DATABASE_URL=mysql+pymysql://USER:PASSWORD@HOST:PORT/Jobs_Intelligence_Austria
VECTOR_STORE_ID=vs_...

# ── Slovakia (COUNTRY=sk) ──────────────────────────────────────────────────────
# Note the DB name in the URL must be Jobs_Intelligence_Slovakia.
DATABASE_URL_SK=mysql+pymysql://USER:PASSWORD@HOST:PORT/Jobs_Intelligence_Slovakia
VECTOR_STORE_ID_SK=vs_...

FLASK_DEBUG=false
FLASK_PORT=5000
